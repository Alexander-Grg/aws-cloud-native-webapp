#!/bin/bash

CYAN='\033[1;36m'
NO_COLOR='\033[0m'
LABEL="db-seed"
printf "${CYAN}== ${LABEL}${NO_COLOR}\n"

seed_path="$(realpath .)/backend-flask/db/sql/seed.sql"

if [ -f ".env" ]; then
  set -a; source .env; set +a
elif [ -f "../.env" ]; then
  set -a; source ../.env; set +a
fi

if [ "$1" = "prod" ]; then
  echo "Running in production mode"
  URL=$PROD_CONNECTION_STRING
else
  echo "Running in development mode"
  URL=$CONNECTION_STRING
fi

URL="${URL/@db/@localhost}"

echo "Seeding database from: $seed_path"

psql "$URL" -f "$seed_path"