services:
  backend-flask:
    image: "${ECR_REGISTRY}/${ECR_BACKEND_REPO}:${IMAGE_TAG}"
    restart: always
    ports:
      - "4567:4567"
    environment:
      AWS_DEFAULT_REGION: "${AWS_DEFAULT_REGION}"
      AWS_COGNITO_USER_POOL_ID: "${AWS_COGNITO_USER_POOL_ID}"
      AWS_COGNITO_USER_POOL_CLIENT_ID: "${AWS_COGNITO_USER_POOL_CLIENT_ID}"
      CONNECTION_STRING: "${CONNECTION_STRING}"
      PROD_CONNECTION_STRING: "${PROD_CONNECTION_STRING}"
      FRONTEND_URL: "${FRONTEND_URL}"
      BACKEND_URL: "${BACKEND_URL}"
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:4567/api/health-check')"]
      interval: 30s
      timeout: 10s
      retries: 3

  frontend-react-js:
    image: "${ECR_REGISTRY}/${ECR_FRONTEND_REPO}:${IMAGE_TAG}"
    restart: always
    ports:
      - "3000:80"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80/"]
      interval: 30s
      timeout: 10s
      retries: 3

  xray-daemon:
    image: "amazon/aws-xray-daemon"
    restart: always
    environment:
      AWS_REGION: "${AWS_DEFAULT_REGION}"
    command:
      - "xray -o -b xray-daemon:2000"
    ports:
      - 2000:2000/udp
